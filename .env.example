# Copie para .env e preencha. O .env não vai para o git.
# Em produção, prefira colocá-lo um nível ACIMA da pasta pública do site
# (o código procura lá primeiro).

# --- Banco de dados (MySQL/MariaDB) -----------------------------------------
# Cada envio do formulário é salvo na tabela `leads` (criar com db/schema.sql).
# DB_NOME vazio = etapa desligada.
DB_HOST=localhost
DB_PORTA=3306
DB_NOME=
DB_USUARIO=
DB_SENHA=

# --- 1. E-mail do lead -------------------------------------------------------
# Quem recebe (separe vários com vírgula)
LEADS_EMAIL_PARA=comercial@grupomeirelles.com.br
# Remetente — use uma conta do próprio domínio, senão cai no spam
LEADS_EMAIL_DE=site@grupomeirelles.com.br
LEADS_EMAIL_DE_NOME="Site Grupo Meirelles"

# SMTP (recomendado). Deixe SMTP_HOST vazio para usar o mail() da hospedagem.
SMTP_HOST=
# tls = STARTTLS na 587 | ssl = 465 | nenhuma
SMTP_SEGURANCA=tls
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=

# --- 2. API (CRM) ------------------------------------------------------------
# URL que recebe um POST JSON com o lead, depois de salvo no banco.
# Vazio = etapa desligada (os leads ficam como "pendente" no banco).
CRM_URL=
# Enviado como "Authorization: Bearer <token>", se preenchido
CRM_TOKEN=
CRM_TIMEOUT=8

# --- Tags de medição e marketing ----------------------------------------------
# Vazio = desligada. Nenhuma tag é baixada antes de a pessoa aceitar os cookies
# (aviso de cookies): GA4 só com "Medição", Meta Pixel só com "Marketing",
# GTM com qualquer um dos dois. Use GTM OU as tags diretas, não as duas para a
# mesma ferramenta (senão as visitas contam em dobro).
# Google Tag Manager — ex.: GTM-ABC1234
GTM_ID=
# Google Analytics 4 — ex.: G-ABC123DEF4
GA4_ID=
# Meta (Facebook/Instagram) Pixel — só números
META_PIXEL_ID=
# Google Search Console: o valor de content="..." da meta tag de verificação
# (só verifica a propriedade; não usa cookies, por isso não depende do aceite)
GOOGLE_SITE_VERIFICATION=
